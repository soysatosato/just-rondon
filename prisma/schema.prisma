generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id           String       @id @default(uuid())
  clerkId      String       @unique
  username     String       @unique
  email        String
  profileImage String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  bookings     Booking[]
  hasVisited   hasVisited[]
}

model Museum {
  id             String         @id @default(uuid())
  name           String         @unique
  slug           String         @unique
  tagline        String?
  category       String?        @default("museum")
  description    String?
  price          Float
  address        String
  lat            Float
  lng            Float
  image          String
  website        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tourPrice      Float
  highlights     String[]
  recommendLevel Int?           @default(0)
  engName        String?
  isForChildren  Boolean        @default(false)
  summary        String?
  blurb          String?
  artworks       Artwork[]
  bookings       Booking[]
  exhibition     Exhibition[]
  museumInfo     MuseumInfo?
  openingHours   OpeningHours[]
  trivia         Trivia[]
  highlightSpots Highlight[]    @relation("MuseumHighlightSpots")
  hasVisited     hasVisited[]
}

model Artwork {
  id             String   @id @default(uuid())
  title          String
  artist         String?
  year           String?
  location       String?
  description    String?
  isOnDisplay    Boolean  @default(true)
  museumId       String   @default("6cc90107-59e4-45a8-b901-abb9748ebeea")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  image          String?
  room           String?
  mustSee        Boolean
  recommendLevel Int      @default(0)
  highlights     String[]
  engTitle       String?
  museum         Museum   @relation(fields: [museumId], references: [id])
}

model hasVisited {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profileId String
  museumId  String
  museum    Museum   @relation(fields: [museumId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [clerkId], onDelete: Cascade)
}

model Booking {
  id            String   @id @default(uuid())
  tourDate      DateTime
  numGuests     Int
  paymentStatus Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profileId     String
  museumId      String
  museum        Museum   @relation(fields: [museumId], references: [id], onDelete: Cascade)
  profile       Profile  @relation(fields: [profileId], references: [clerkId], onDelete: Cascade)
}

model OpeningHours {
  id        String  @id @default(uuid())
  museumId  String
  dayOfWeek String
  openTime  String?
  closeTime String?
  museum    Museum  @relation(fields: [museumId], references: [id])

  @@unique([museumId, dayOfWeek])
}

model Exhibition {
  id          String   @id @default(cuid())
  museumId    String
  name        String
  description String
  startDate   DateTime
  endDate     DateTime
  admission   Float
  Museum      Museum   @relation(fields: [museumId], references: [id])
}

model Trivia {
  id       String @id @default(cuid())
  museumId String
  title    String
  content  String
  Museum   Museum @relation(fields: [museumId], references: [id])
}

/// 館ごとの「これだけは見て帰る」ポイント。
/// Artwork は画像と作者を伴う作品単位のデータで6館しか揃っていないため、
/// 展示室・建築・体験など作品以外も指せる軽いテキストとして分けている。
model Highlight {
  id        String  @id @default(cuid())
  museumId  String
  title     String
  /// どこにあるか（例: "Room 4"、"1階 中央ホール"）。不明なら null。
  location  String?
  body      String
  /// 表示順。小さいほど先。
  order     Int     @default(0)
  museum    Museum  @relation("MuseumHighlightSpots", fields: [museumId], references: [id], onDelete: Cascade)

  @@index([museumId])
}

model MuseumInfo {
  id                    String   @id @default(cuid())
  museumId              String   @unique
  photographyAllowed    String?
  reservationRequired   Boolean?
  cloakroomInfo         String?
  nearestStation        String?
  stationWalkingMinutes Int?
  nearestBusStop        String?
  busStopWalkingMinutes Int?
  guidedTourAvailable   Boolean?
  guidedTourLanguages   String?
  cafeteriaAvailable    Boolean?
  shopAvailable         Boolean?
  wifiAvailable         Boolean?
  website               String?
  admissionFeeAdult     Float?
  admissionFeeStudent   Float?
  admissionFeeChild     Float?
  recommendedDuration   Int?
  guidedTourFee         Float?
  museum                Museum   @relation(fields: [museumId], references: [id])
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String
  tags        String[]
  views_count Int      @default(0)
  image       String   @default("/news-bg.JPG")
  summary     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// ウエストエンドの劇場。
///
/// Musical から theatreName / address / lat / lng を切り出したもの。
/// 作品と劇場を 1:1 で持つと、作品が移動したときに劇場の情報
/// (座席の癖、最寄駅、バリアフリー)まで一緒に動いてしまう。実際
/// Six と Oliver! は移動しており、Hadestown も Lyric に入り直している。
/// 劇場は作品より寿命が長いので、別テーブルに置いて作品から参照する。
///
/// 1劇場に複数作品がぶら下がる状態(前の作品が終わり次が入るまでの
/// 期間や、同一劇場での入れ替え)も、この形なら壊れずに表せる。
model Theatre {
  id       String @id @default(cuid())
  slug     String @unique
  /// 英語の正式名称。"Sondheim Theatre" のように Theatre まで含める。
  name     String
  /// 日本語表記。検索されるのは英語名だが、本文中では日本語で呼ぶ。
  nameJa   String
  address  String
  lat      Float
  lng      Float

  /// 最寄り駅。"Piccadilly Circus (Bakerloo, Piccadilly)" のように
  /// 路線まで書く。/sightseeing/transport から来た読者が乗り換えを
  /// 判断できる粒度にする。
  nearestStation String?
  /// 客席数。座席の選び方を書くときの前提になる(500席の劇場と
  /// 2000席の劇場では「後方席」の意味がまるで違う)。
  capacity       Int?
  /// 劇場を運営するグループ。ATG / LW Theatres / Delfont Mackintosh /
  /// Nimax など。公式チケットの購入先を見分ける手がかりになるため、
  /// /musicals/west-end-tickets の記述と揃えて使う。
  operator       String?
  /// この劇場ならではの実務メモ。座席の見切れ、階段の多さ、
  /// クロークの有無など。markdown 可。
  ///
  /// 以下の3フィールドに分割済み。新しい原稿は分割先に書くこと。
  /// 分割が済んでいない劇場のフォールバックとして残している。
  notes          String?

  /// 劇場の第一印象と成り立ち(markdown、1〜2段落)。
  ///
  /// 座席や設備の話に入る前に、どんな建物なのかを地の文で示す。
  /// 実務情報だけが並ぶページは読者が劇場を選ぶ手がかりにならない
  /// ——同じ「1200席・徒歩3分」でも、1900年代の装飾が残る劇場と
  /// 改装済みの劇場では観劇の体験がまるで違う。
  intro          String?
  /// 座席の選び方(markdown)。
  ///
  /// 読者が劇場ページに来る最大の動機。区画ごとの見え方、見切れ、
  /// 傾斜、双眼鏡の要否を書く。capacity だけでは席を選べない。
  seatingNotes   String?
  /// 当日の動き方(markdown)。
  ///
  /// 入口の分かりにくさ、階段とエレベーターの有無、クローク、
  /// トイレの混み方、開演前の過ごし方。座席選び(予約時に読む)とは
  /// 読むタイミングが違うので分けている。
  visitNotes     String?

  /// 劇場情報を人が最後に確認した日。Musical.lastVerifiedAt と同じ理由で
  /// updatedAt とは別に持つ。null は「一度も確認していない」。
  lastVerifiedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  musicals  Musical[]
}

model Musical {
  id             String   @id @default(uuid())
  name           String
  engName        String
  slug           String   @unique
  tagline        String?
  /// 幕ごとのシーン運び(markdown)。あらすじ3層のうち「物語の流れ」にあたる。
  ///
  /// 結末は含めない。まだ観るか決めていない読者が最初に開くページなので、
  /// 結末は storyEnding に切り出して折りたたみの中にだけ置く。
  description    String
  summary        String
  blurb          String?

  /// 「どんな話か」を語る地の文(markdown、2〜3段落)。
  ///
  /// あらすじ3層の入口。箇条書きのシーン運び(description)は
  /// 出来事の記録としては正確でも、固有名詞が並ぶだけで作品の
  /// 魅力が伝わらない。何に心を動かされる話なのかを先に地の文で
  /// 示し、読者が固有名詞を受け取れる状態を作る。
  ///
  /// 結末は書かない。null は未執筆で、表示側は層ごと出さない。
  storyHook      String?
  /// 主な登場人物。あらすじ3層のうち「誰の話か」にあたる。
  ///
  /// MusicalCharacter[] の JSON。形は components/musicals/story.ts が
  /// 持つ。別テーブルにしないのは、人物が作品ページの外で使われず、
  /// 並び順そのものが原稿の一部(主人公から関係の遠い順)だから。
  ///
  /// null は未執筆で、表示側は層ごと出さない。
  characters     Json?
  /// 結末(markdown)。折りたたみの中にだけ出す。
  ///
  /// description から切り出して分けているのは、観るか迷っている読者と
  /// 予習してから観たい読者で、読みたいものが正反対だから。既定は閉。
  ///
  /// null は「切り出し済みでない」。表示側は折りたたみごと出さない。
  storyEnding    String?
  /// 見どころと裏話。MusicalAppeal[] の JSON。
  ///
  /// あらすじが「何が起きるか」を答えるのに対し、こちらは
  /// 「なぜ観る価値があるか」を答える。筋を知っただけでは伝わらない、
  /// 劇場でしか起きないこと(舞台機構・生の歌唱・客席の反応)と、
  /// 知っていると見え方が変わる制作の背景を持つ。
  ///
  /// kind で見どころ("highlight")と裏話("trivia")を区別する。
  /// 形は components/musicals/story.ts が持つ。
  ///
  /// null は未執筆で、表示側は層ごと出さない。
  appeals        Json?
  highlights     String[]
  /// 上演劇場。移行が済むまで theatreName と併存する。
  ///
  /// null は「まだ Theatre に紐付けていない」。表示側は theatre を
  /// 優先し、無ければ theatreName にフォールバックすること。
  theatreId      String?
  theatre        Theatre? @relation(fields: [theatreId], references: [id])
  theatreName    String
  address        String
  lat            Float
  lng            Float
  image          String
  website        String
  isOnShow       Boolean
  recommendLevel Int      @default(0)
  mustSee        Boolean
  original       String   @default("")

  /// 上演時間(分)。休憩を含む総所要時間。
  ///
  /// 滞在日程を組むうえで読者が予約前に必ず調べる情報だが、これまで
  /// サイト内のどこにも無かった。null は「未確認」で、表示side は
  /// 項目ごと出さない。推定値を入れてはいけない——「2時間半で終わる」
  /// と読んで夕食を予約した読者が、3時間の公演で間に合わなくなる。
  runtimeMinutes    Int?
  /// 休憩(interval)の有無と長さ(分)。0 は「休憩なしで通す」、
  /// null は未確認。runtimeMinutes に含まれる内数。
  intervalMinutes   Int?
  /// 劇場が案内する推奨年齢の下限。"6歳以上" なら 6。
  ///
  /// 法的な入場制限ではなく劇場の推奨なので、断定せず
  /// 「劇場の推奨」として出すこと。null は未確認。
  minAgeGuidance    Int?

  /// 英語のハードルを判断する材料。断定的な「難易度」ではなく、
  /// 読者が自分で判断するための事実を持つ。
  ///
  /// 星やスコアで表さないのは、英語力は読者ごとに違い、同じ作品でも
  /// 「原作を知っているか」で体感が変わるため。サイトが一次元の
  /// 難易度を宣言すると、外れたときに読者の一晩を無駄にする。
  /// 代わりに form と note で根拠を出し、判断は読者に残す。
  ///
  /// "sung-through"(ほぼ全編歌) / "dialogue-heavy"(台詞中心) /
  /// "balanced"(歌と台詞が半々) / "non-verbal"(台詞にほぼ依存しない)。
  /// null は未確認。
  englishForm       String?
  /// 上の form を補う一文。「原作アニメが日本で広く知られており
  /// 筋を追いやすい」「早口のラップで情報量が多い」など、
  /// なぜそう言えるかの根拠を必ず含めること。
  englishNote       String?
  /// 上演時間・年齢・英語まわりを人が最後に確認した日。
  /// isOnShow の確認(lastVerifiedAt)とは別物なので分けて持つ。
  /// 作品が同じでも演出改訂で上演時間は変わる。
  factsVerifiedAt   DateTime?
  /// isOnShow と上演劇場を人が最後に確認した日。
  ///
  /// updatedAt では代用できない。あちらは説明文の推敲でも動くので、
  /// 「文章を直しただけ」と「公演中かを確かめた」が区別できない。
  /// 終演済みの作品が上演中として残り続ける事故を防ぐのが目的なので、
  /// 確認したという行為だけを別に記録する。
  ///
  /// null は「一度も確認していない」。scripts/check-musical-freshness.ts
  /// で棚卸しし、確認できたものだけ日付を入れる。
  lastVerifiedAt DateTime?
  /// Ticketmaster の attraction ID。公演日程の取得キー。
  ///
  /// 名寄せで自動的に埋めてはいけない。TM 側の名称は "Hadestown (Touring)"
  /// のようにロンドン公演かどうかを表さず、劇場も一致してしまうことがある
  /// (実際 Lyric Theatre のツアー公演が MJ The Musical に一致した)。
  /// 別公演の日程を正しい作品として出す事故になるので、
  /// scripts/link-musical-ticketmaster.ts で人が確認した組だけを入れる。
  ///
  /// null は「TM に在庫がない」または「未確認」。日程は表示しない。
  ticketmasterAttractionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  songs          Song[]
  performances   MusicalPerformance[]
}

/// Ticketmaster から取り込んだ公演1回分。
///
/// 上演スケジュールは日次で作り直す前提の派生データなので、
/// 人が書いた Musical とは別テーブルに置く。同期が失敗しても
/// 作品ページ本体は無傷で残る。
model MusicalPerformance {
  id        String   @id @default(cuid())
  musicalId String
  musical   Musical  @relation(fields: [musicalId], references: [id], onDelete: Cascade)

  /// TM のイベントID。再同期時の重複防止に使う。
  eventId   String   @unique
  /// 現地時刻での開演日時。TM は localDate/localTime を分けて返すので、
  /// ロンドンの現地時刻として組み立てて保存する。
  startsAt  DateTime
  /// 開演時刻が未定の公演があるため、日付だけ確定しているケースを区別する。
  timeTba   Boolean  @default(false)
  /// 購入ページ。作品共通ではなく公演ごとに異なる。
  url       String?
  /// onsale | offsale | cancelled | postponed | rescheduled
  status    String   @default("onsale")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([musicalId, startsAt])
}

model Song {
  id        String   @id @default(cuid())
  name      String
  artist    String
  lyrics    String
  scene     String
  musicalId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  index     Int
  youtubeId String?
  musical   Musical  @relation(fields: [musicalId], references: [id])
}

model Post {
  id           String    @id @default(cuid())
  category     String    @default("none")
  author       String
  deletePsswrd String    @default("0000")
  title        String
  content      String
  votes        Int       @default(0)
  views        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  ip           String?
  sessionId    String?
  userAgent    String?
  comments     Comment[]
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  parentId  String?
  author    String
  content   String
  votes     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ip        String?
  sessionId String?
  userAgent String?
  parent    Comment?  @relation("CommentToChildren", fields: [parentId], references: [id])
  children  Comment[] @relation("CommentToChildren")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Contact {
  id        String  @id @default(cuid())
  email     String
  token     String  @unique
  message   String
  name      String
  confirmed Boolean @default(false)
}

model Attraction {
  id             String              @id @default(uuid())
  name           String              @unique
  engName        String?
  slug           String              @unique
  tagline        String?
  summary        String?
  address        String
  lat            Float
  lng            Float
  image          String
  website        String?
  recommendLevel Int?                @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  category       String              @default("")
  mustSee        Boolean             @default(false)
  isForKids      Boolean             @default(false)
  isFree         Boolean             @default(false)
  sections       AttractionSection[]

  /// -------------------------------------------------------------------
  /// 訪問前に知りたい実用情報。すべて nullable。
  ///
  /// もともと sections の本文に散らばっていたものを
  /// scripts/migrate-attraction-facts.ts で抽出して埋めている。
  /// セクション見出しの表記ゆれ(「料金・チケット情報」「チケット情報」
  /// 「チケット料金」「料金」がすべて同義)のせいで、読者は毎ページ
  /// 違う位置から同じ事実を探す羽目になっていた。
  ///
  /// 抽出が曖昧なものは埋めずに null のままにしてある。誤った料金を
  /// 出すくらいなら、その行を出さないほうがよい。表示側は null を
  /// 素通りする作りにすること。
  /// -------------------------------------------------------------------

  /// 大人料金の表示用文字列(例: "£35.8〜")。無料スポットは "無料"。
  priceAdult     String?
  /// 子ども料金の表示用文字列。
  priceChild     String?
  /// 所要時間の目安(例: "3時間〜")。数値ではなく原文の幅を保つ。
  durationText   String?
  /// 最寄駅と徒歩分(例: "Tower Hill 徒歩5分")。
  nearestStation String?
  /// 開館時間(例: "9:00〜17:30 (最終入場16:30)")。季節変動は代表値。
  openingHours   String?

  /// -------------------------------------------------------------------
  /// エリアガイド(/sightseeing/areas)用の街区。
  ///
  /// 値は components/sightseeing/areas/areas.ts の AreaSlug と一致させる。
  /// 未分類は null のままにしておくこと——「半日この辺りを歩く」に
  /// 入らないスポット(郊外のスタジアム等)を無理に寄せると、
  /// 回遊記事としての精度が落ちる。
  ///
  /// lat/lng から機械的に導出しない。テムズ川を挟んだ対岸や、
  /// セント・ポール大聖堂のように「座標上はシティの矩形外だが
  /// 地区の象徴」であるスポットを、境界線では表現できないため。
  /// 付与は scripts/assign-attraction-areas.ts で行う。
  /// -------------------------------------------------------------------
  area           String?

  /// 到着してからの流れ。心が躍る部分をここに書く。
  ///
  /// 既存 sections から機械的に作れないので、書けたスポットにだけ
  /// 入れて、無いページでは丸ごと非表示にする。推測で埋めないこと
  /// ——「入口を入ってすぐ左」のような具体は、外れると読者を
  /// 実際に迷わせる。
  visitFlow      AttractionVisitStep[]

  /// 読み物本文。AttractionSection の後継(移行中)。
  stories        AttractionStory[]

  @@index([area])
}

/// 観光スポットの読み物1本。AttractionSection の後継。
///
/// 旧 AttractionSection は title が自由文字列だったため、135スポットで
/// 172種類の見出しが生まれ、うち138種類は1件しか使われていなかった
/// (「アクセス」「アクセス方法」「所在地」「場所」がすべて同義)。
/// 表示側は見出しを正規表現で推測するしかなく、実際
/// isRedundantOverview() は145件の「概要」に対して0件しか検出できていない。
///
/// そこで kind を固定値に限定し、表示用の見出しは飾りとして分離する。
/// 並び順・重複判定・非表示の判断はすべて kind で行う。
///
/// 事実(料金・アクセス・開館時間・所要時間)はここに入れない。
/// Attraction のカラムが持つ。本文に事実を書くとファクトバーと二重になり、
/// 改定のたびに両方直す必要が出る。実際、旧 sections では393節・約61,000字が
/// ファクトバーと重複し、表示側で伏せられたまま誰にも読まれていなかった。
model AttractionStory {
  id           Int        @id @default(autoincrement())
  attractionId String
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  /// "highlight" | "history" | "trivia" | "practical" | "context"
  ///
  /// ★ 自由入力しないこと。172種類の見出しが生まれた原因はここが
  /// 自由文字列だったことにある。増やすときは components/sightseeing の
  /// 並び順と既定ラベルも同時に直す。
  kind         String
  /// 表示用の見出し。null なら kind ごとの既定ラベルを使う。
  /// 「なぜ中世の城のような外観なのか」のような、そのスポット固有の
  /// 見出しにだけ値を入れる。
  heading      String?
  /// 本文。markdown。MarkdownBody で描画する。
  body         String

  /// "migrated" | "authored"
  ///
  /// 移行スクリプトが作り直してよい行かどうかの目印。
  /// migrate-sections-to-stories.ts は旧 AttractionSection から機械的に
  /// 作り直す都合上、スポット単位で deleteMany してから createMany する。
  /// この目印がないと、手で書き直した本文まで巻き添えで消える
  /// (実際に level 5 / level 4 の書き直しが1度消えている)。
  ///
  /// 移行スクリプト側は source: "migrated" の行だけを消すこと。
  /// seed-attraction-stories-*.ts が書く行は "authored" にする。
  source       String   @default("migrated")

  /// 節に添える画像。当面はほぼ null。
  ///
  /// URL 単体で持たないのは、Commons の画像が作者名とライセンスの表記を
  /// 要求するため。URL だけを持つと表記が本文と分離し、差し替えたときに
  /// 古い表記が残る。BrandImage / Souvenir と同じ扱いにそろえている。
  imageUrl     String?
  /// "commons" | "official" | "own" 等。表示側の分岐に使う。
  imageSource  String?
  /// 出典・ライセンス表記。commons のときは必須。
  imageCredit  String?
  imageLink    String?
  /// 画像の下に出す説明。何が写っているかと、本文のどこに効くかを書く。
  imageCaption String?

  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([attractionId, displayOrder])
}

/// visitFlow の1ステップ。到着→見どころ→見落としやすいもの、の順に並べる。
model AttractionVisitStep {
  id           Int        @id @default(autoincrement())
  attractionId String
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  displayOrder Int

  /// "arrival" | "highlight" | "missable" | "tip"。表示側でアイコンと色を切り替える。
  kind         String     @default("highlight")
  /// 見出し(例: "クラウンジュエル")。
  title        String
  /// 2〜3文。何が見えるか、どう感じるか。
  body         String

  createdAt    DateTime   @default(now())

  @@index([attractionId, displayOrder])
}

// イギリス料理1品(/restaurants/[slug])。
//
// 店ではなく料理を軸にしているのは、読者が「フィッシュ&チップスを食べたい」
// から店を探すため。もうひとつ実務的な理由があり、店の写真は権利処理が
// 面倒なのに対して料理の写真は自由に使えるものが揃っているので、
// 料理を単位にすると各ページが確実に1枚は画像を持てる。
model Dish {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  engName    String
  tagline    String
  /// ハブ(/restaurants)のカードに出す説明。
  summary    String
  /// 料理そのものの解説。markdown。
  body       String
  /// 頼み方・食べ方のコツ。markdown。
  howTo      String?
  priceRange String?
  /// 「土曜の昼」「日曜だけ」など、食べに行くべき時間帯。
  bestTime   String?

  image       String?
  imageSource String?
  imageCredit String?
  imageLink   String?

  displayOrder Int          @default(0)
  restaurants  Restaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 料理に紐づく店。
//
// 1つの店が複数の料理を出すことはあるが(パブは日曜ローストも朝食も出す)、
// 特集としては「その店を何で推すのか」が定まっている方が読みやすいので
// 多対多にはしていない。両方で推したくなったら、そのとき初めて中間表を作る。
//
// 住所を持たせていないのは番地の裏取りができないため。エリアと最寄り駅、
// そして公式サイトへのリンクがあれば読者は辿り着ける。
model Restaurant {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  engName String
  dishId  String
  dish    Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)

  /// カード用の一言。なぜこの店なのかを1文で。
  blurb String
  body  String?

  area            String
  nearestStation  String?
  priceRange      String?
  website         String?
  bookingRequired Boolean @default(false)

  /// 店の公式アカウントの「投稿」URL(https://www.instagram.com/p/... )。
  /// プロフィールURLでは埋め込めない。Instagram はプロフィール単位の
  /// 埋め込みを廃止しており、埋め込めるのは個別の投稿と Reels だけ。
  instagramUrl String?

  image       String?
  imageSource String?
  imageCredit String?
  imageLink   String?

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dishId])
}

// ロンドン土産の特集(/souvenirs)で紹介する1品。
//
// image を nullable にしているのは、写真を自前で撮らない運用が前提だから。
// 「画像が揃ってから公開する」にすると1件も出せなくなるので、
// 画像なしでも成立するカードを描く前提で null を許容している。
//
// imageSource は表示側の分岐に使う。ライセンス表記が要るソース(commons)と、
// 提携先のCDNから直接配信しなければならないソース(rakuten / amazon)とで
// 扱いが変わるため、URL だけを持っていても正しく描けない。
model Souvenir {
  id             String   @id @default(cuid())
  name           String
  engName        String?
  slug           String   @unique
  category       String
  /// カード用の一言。詳細を開かなくても選べる粒度で書く。
  blurb          String
  /// 詳細の本文。markdown。
  body           String
  priceRange     String?
  /// 買える場所。「ヒースロー空港」「Tesco」など。
  buyAt          String[] @default([])
  tips           String?
  recommendLevel Int      @default(0)
  displayOrder   Int      @default(0)

  image        String?
  /// "commons" | "rakuten" | "amazon" | "official" | "own"
  imageSource  String?
  /// 出典・ライセンス表記。commons のときは必須。
  imageCredit  String?
  imageLink    String?
  affiliateUrl String?

  /// ブランド公式アカウントの「投稿」URL(https://www.instagram.com/p/... )。
  /// プロフィールURLでは埋め込めない。Instagram はプロフィール単位の
  /// 埋め込みを廃止しており、埋め込めるのは個別の投稿と Reels だけ。
  instagramUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// イギリス発のブランド1社(/brands/[slug])。
//
// Souvenir と軸が違う。あちらは品目単位で「誰に何を配るか」を扱うのに対し、
// こちらはブランド単位で「その会社が何者で、ロンドンのどこで、いくらで買えるか」
// を扱う。Twinings のように両方に登場する名前はあるが、書く内容が重ならないので
// 統合しない。
//
// 本文を story と buying の2本に割っているのは、読者の来方が二通りあるため。
// 「バーバリー 歴史」で来た人と「バーバリー ロンドン 安い」で来た人が同じ順に
// 読むことはないので、1本の body に混ぜると必ずどちらかが読み飛ばしになる。
model Brand {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  engName  String
  /// "fashion" | "footwear" | "outdoor" | "beauty" | "homeware" | "food"
  category String
  /// カード用の一言。詳細を開かなくても選べる粒度で書く。
  blurb    String
  /// 特徴・魅力。markdown。ページの最初に読ませる。
  /// 歴史より前に置くのは、読者がまず知りたいのが「何が良いのか」であって
  /// 「いつ誰が創業したか」ではないため。年号から入ると大半が離脱する。
  appeal   String
  /// 歴史。markdown。創業の経緯、定番品が生まれた背景。
  story    String
  /// 買い方の実務。markdown。日本との価格差、いつ買うか。
  buying   String

  founded      Int?
  /// 発祥地。「ロンドン・ストランド」「ノーサンバーランド州」など。
  origin       String?
  /// 王室御用達(Royal Warrant)を現在保持しているか。
  /// authorised が取り消される例があるので、過去の保持は true にしない。
  royalWarrant Boolean @default(false)

  priceRange String?
  website    String?
  tips       String?

  /// 公式アカウントの「投稿」URL(https://www.instagram.com/p/... )。
  /// プロフィールURLでは埋め込めない(Restaurant.instagramUrl と同じ制約)。
  ///
  /// ヒーロー画像と併存させるのは、Commons にあるのが店舗外観や史料の写真
  /// ばかりで、そのブランドが「今」何を作っているのかが写らないため。
  /// 商品そのものは公式の投稿を埋め込むのが、複製を伴わない分いちばん安全。
  instagramUrl String?

  recommendLevel Int @default(0)
  displayOrder   Int @default(0)

  image       String?
  /// "commons" | "rakuten" | "amazon" | "official" | "own"
  imageSource String?
  /// 出典・ライセンス表記。commons のときは必須。
  imageCredit String?
  imageLink   String?

  items  BrandItem[]
  images BrandImage[]
  stores BrandStore[]
  faqs   BrandFaq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// ブランドを買える場所。旗艦店・直営店・アウトレット・取扱店。
///
/// 以前は Brand.buyAt(文字列配列)と Brand.flagship(1行テキスト)に分かれていたが、
/// 同じ店が両方に出て内容がずれるため一本化した。
///
/// 営業時間は持たない。変わりやすく、古い時間を載せたままにすると
/// 「行ったら閉まっていた」を引き起こす(Restaurant と同じ判断)。
/// 開いているかは公式サイトで確認してもらう。
model BrandStore {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// "flagship"(旗艦店) | "store"(直営店) | "outlet"(アウトレット) | "retailer"(取扱店・百貨店/スーパー)
  kind           String
  name           String
  /// 番地まで。retailer で特定の店舗を指さない場合は null。
  address        String?
  nearestStation String?
  /// その店ならではの事情。「ここだけ限定ブレンドがある」「間口が狭く見落としやすい」など。
  note           String?

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, displayOrder])
}

/// ブランドごとのFAQ。
///
/// ハブ(/brands)のFAQが買い物全般の前提を扱うのに対し、こちらは
/// そのブランドでだけ生じる疑問を扱う。サイズの選び方、持ち帰りの可否、
/// 日本との違いなど、ブランドによって答えが変わるものだけを置く。
///
/// 本文の再掲になっても構わない。FAQ の構造化データは質問文で検索された
/// ときに拾われるので、同じ情報でも到達経路が増える。
model BrandFaq {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  question String
  /// markdown可。JSON-LD に出す際は stripInlineMarkdown() を通すこと。
  answer   String

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, displayOrder])
}

/// 記事の途中に挟む画像。Brand.image(冒頭のヒーロー)とは別物。
///
/// 本文の markdown に ![](...) を直接書かないのは、Commons の画像が
/// 作者名とライセンスの表記を要求するため。URL だけを本文に埋めると
/// 表記が本文と分離して、差し替えたときに古い表記が残る。
/// 画像と出典を1レコードにまとめ、表示側で必ず並べて描く。
model BrandImage {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// 本文のどのセクションの後に置くか。"story" | "buying"
  section String
  url     String
  /// 画像の下に出す説明。何が写っているかだけでなく、本文のどこに効くかを書く。
  caption String

  imageSource String?
  imageCredit String?
  imageLink   String?

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, section, displayOrder])
}

/// ブランドの定番アイテム。「そのブランドで何を買えばいいか」に答えるためのもので、
/// 在庫や現在価格は追わない。priceRange は幅で持ち、変動しても嘘にならない粒度にする。
model BrandItem {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name       String
  engName    String?
  /// なぜこれが定番なのかの一言。
  note       String
  priceRange String?

  /// 定番品そのものの写真。
  ///
  /// ブランドの魅力は結局「何が買えるか」なので、外観写真より効く。
  /// ただし商品写真は Commons にほぼ無く、出典は公式か Commons に限る。
  /// 通販サイトの商品画像を直リンクすると、URLが切れたときに黙って
  /// 画像が消えるうえ、そもそも再配布の許諾がない。
  image       String?
  /// "commons" | "official"
  imageSource String?
  /// 出典・ライセンス表記。commons のときは必須。
  imageCredit String?
  imageLink   String?

  affiliateUrl String?
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, displayOrder])
}

/// ★ 移行中: AttractionStory に置き換える。新規に書き足さないこと。
///
/// title が自由文字列であることが構造上の欠陥で、同じ話題に172種類の
/// 見出しが生まれた。移行の経緯と割り当ては
/// scripts/PLAN-attraction-story.md と scripts/survey-attraction-sections.ts
/// を参照。表示側が AttractionStory へ切り替わり、本番で問題がないことを
/// 確認できたら、このモデルは別途削除する。
model AttractionSection {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  displayOrder Int
  attractionId String
  createdAt    DateTime   @default(now())
  attraction   Attraction @relation(fields: [attractionId], references: [id])
}

model Content {
  id           String           @id @default(cuid())
  title        String
  engTitle     String?
  slug         String
  summary      String?
  mainText     String?
  description  String?
  description2 String?
  description3 String?
  image        String?
  website      String?
  category     String           @default("")
  route        String           @default("")
  // コラムのテーマ分類。/column のフィルタに使う（例: ["history", "person"]）
  tags         String[]         @default([])
  // 連載コラムのみ設定。同じ seriesName を持つ Content が1つの連載を構成する
  seriesName   String?
  seriesOrder  Int?
  sections     ContentSection[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
}

model ContentSection {
  id           Int      @id @default(autoincrement())
  title        String
  subtitle     String?
  description  String?
  description2 String?
  description3 String?
  displayOrder Int      @default(0)
  image        String?
  contentId    String
  content      Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String
  startDate       DateTime
  endDate         DateTime
  image           String?
  website         String?
  displayOrder    Int      @default(0)
  // 「特徴・おすすめポイント」など、開催概要だけでは分からない実用情報
  category        String?
  venue           String?
  area            String?
  nearestStation  String?
  priceInfo       String?
  isFree          Boolean  @default(false)
  bookingRequired Boolean  @default(false)
  highlights      String[] @default([])
  tips            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startDate])
}

/// 「今週のロンドン」週次ダイジェストの1号分。
/// Event テーブル(1年前から分かっている定番イベント)とは役割が違う。
/// こちらは「4週間前には書けなかったこと」= ストライキ・突発イベント・耳寄り情報だけを扱う。
model WeeklyBrief {
  id           String            @id @default(cuid())
  /// "2026-w33"。ISO週番号ベースで、週の月曜から一意に決まる。
  slug         String            @unique
  /// 週の月曜 00:00 UTC。weekEnd はその週の日曜 00:00 UTC。
  weekStart    DateTime
  weekEnd      DateTime
  title        String
  /// 「今週はここに注意」の1〜2文。ページ冒頭に大きく出す。
  headline     String
  summary      String
  image        String?
  /// 調査した日時。ページに「◯月◯日 調査時点」として必ず表示する。
  /// ストライキ情報は数日で覆るので、いつ時点の情報かを出さないと誤情報になる。
  researchedAt DateTime
  /// 下書き段階で公開されないようにするためのフラグ。
  published    Boolean           @default(false)
  items        WeeklyBriefItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([weekStart])
  @@index([published, weekStart])
}

model WeeklyBriefItem {
  id      String      @id @default(cuid())
  briefId String
  brief   WeeklyBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  /// 支障系: strike | disruption | closure | crowd
  /// 機会系: event | exhibition | deal | opening
  /// 環境系: weather | holiday
  kind     String
  /// 支障系のみ。high(旅程の変更が要る) | medium(迂回で回避可) | low(知ると快適)
  severity String?
  /// なぜ今週号に載るか。thisWeek(今週起きる) | announced(今週判明した/発生は先)
  timing   String  @default("thisWeek")
  /// confirmed | planned。ストライキ予告は直前の妥結で中止になるため planned は本文で明示する。
  status   String  @default("confirmed")

  title       String
  description String

  startDate      DateTime?
  endDate        DateTime?
  venue          String?
  area           String?
  nearestStation String?
  priceInfo      String?
  isFree         Boolean   @default(false)
  website        String?

  /// 出典URL。一次ソース(TfL・会場公式・労組公式)優先。必須。
  source     String
  /// 二次ソース(Time Out London 等)の場合に媒体名を出して読者に判別させる。
  sourceName String?

  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([briefId, displayOrder])
}

model Lyrics {
  id           String        @id @default(cuid())
  name         String
  artistId     String
  lyrics       String
  album        String?
  youtubeId    String?
  views        Int           @default(0)
  lastViewedAt DateTime?
  genre        String?
  createdAt    DateTime      @default(now())
  scene        String?
  year         Int           @default(0)
  month        Int           @default(0)
  albumOrder   Int           @default(0)
  artist       Artist        @relation(fields: [artistId], references: [id])
  rankings     Ranking[]
  slangs       LyricsSlang[]

  @@index([artistId, album])
}

model Slang {
  id          String        @id @default(cuid())
  term        String        @unique
  slug        String        @unique
  meaning     String
  explanation String?
  category    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lyrics      LyricsSlang[]
}

model LyricsSlang {
  id           String   @id @default(cuid())
  lyricsId     String
  slangId      String
  lineExcerpt  String?
  contextNote  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  lyrics       Lyrics   @relation(fields: [lyricsId], references: [id], onDelete: Cascade)
  slang        Slang    @relation(fields: [slangId], references: [id], onDelete: Cascade)

  @@unique([lyricsId, slangId])
  @@index([slangId])
}

model Artist {
  id        String    @id @default(cuid())
  name      String
  engName   String
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isHot     Boolean?
  songs     Lyrics[]
  rankings  Ranking[]
}

model Ranking {
  id          String      @id @default(cuid())
  type        RankingType
  rank        Int
  periodStart DateTime
  periodEnd   DateTime
  lyricsId    String?
  artistId    String?
  album       String?
  artist      Artist?     @relation(fields: [artistId], references: [id])
  lyrics      Lyrics?     @relation(fields: [lyricsId], references: [id])

  @@index([type, periodEnd])
}

model LyricsRequest {
  id        Int      @id @default(autoincrement())
  title     String
  artist    String?
  createdAt DateTime @default(now())
}

model Store {
  id         String   @id @default(cuid())
  name       String
  address    String
  lat        Float?
  lng        Float?
  borough    String?
  postcode   String?
  aliases    String[] @default([])
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([name])
}

model ServiceCharge {
  id                     String   @id
  placeId                String
  storeName              String
  storeAddress           String
  lat                    Float?
  lng                    Float?
  borough                String?
  postcode               String?
  isVerified             Boolean  @default(true)
  serviceChargeCollected Boolean
  distributionType       String?
  amountPeriod           String?
  amountValue            Float?
  createdAt              DateTime @default(now())
  ethnicityRatio         String?
  generalComment         String?
  managementPresence     String?
  mealCountPerDay        String?
  mealDrink              String?
  mealRestrictions       String[]
  serviceChargeComment   String?
  shiftSchedule          String?
  visaSupport            String?
  workAtmosphere         String?
  mealComment            String?

  @@index([placeId])
  @@index([serviceChargeCollected])
}

model RedditPost {
  id           String   @id @default(cuid())
  title        String
  titleJa      String
  authorId     String?
  createdAt    DateTime @default(now())
  redditId     String
  displayOrder Int
  reddit       Reddit   @relation(fields: [redditId], references: [id])

  @@index([redditId])
}

model Reddit {
  id        String       @id @default(cuid())
  imageUrl  String?
  title     String       @unique
  titleJa   String
  authorId  String?
  postedAt  DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  body      String
  bodyJa    String
  posts     RedditPost[]
}

enum RankingType {
  HOT_SONGS
  HOT_ARTISTS
  HOT_ALBUM
}

/// X(旧Twitter)投稿用の下書き。just-rondon公式アカウントの定期投稿ネタを
/// ストックしておき、人が /tweets で内容を確認してコピペ投稿する運用。
/// 投稿APIとの連携は無いため、投稿自体は手動。
model TweetDraft {
  id        String    @id @default(cuid())
  /// 投稿本文。日本語で140字目安(絵文字・改行込み)。
  body      String
  /// tip(耳寄り情報) | fact(あるあるネタ) | question(問いかけ系) など、ネタの種類。
  category  String
  /// draft(未投稿) | posted(投稿済み) | rejected(不採用)
  status    String    @default("draft")
  postedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
}

/// PageComment が紐づく対象の種類。セクションを増やすときはここに1行足す。
enum CommentTargetType {
  FOOD_TIP
  COLUMN
  ATTRACTION
  MUSEUM
  HOUSING
}

/// 記事ページ用の汎用コメント。掲示板(Post/Comment)とは別系統で、
/// targetType + targetKey の組で任意のページに紐づけられる。
/// 外部キーは張らないため、対象が消えてもコメントは残る点に注意。
model PageComment {
  id         String            @id @default(cuid())
  targetType CommentTargetType
  /// 対象の識別子。slug(food/column)と uuid(attraction/museum)が混在するため String。
  targetKey  String
  author     String
  content    String
  /// 荒らし対応は物理削除ではなく論理削除で隠す。
  isHidden   Boolean           @default(false)
  createdAt  DateTime          @default(now())
  ip         String?
  sessionId  String?
  userAgent  String?

  @@index([targetType, targetKey, createdAt])
}
