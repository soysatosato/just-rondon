generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id           String       @id @default(uuid())
  clerkId      String       @unique
  username     String       @unique
  email        String
  profileImage String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  bookings     Booking[]
  hasVisited   hasVisited[]
}

model Museum {
  id             String         @id @default(uuid())
  name           String         @unique
  slug           String         @unique
  tagline        String?
  category       String?        @default("museum")
  description    String?
  price          Float
  address        String
  lat            Float
  lng            Float
  image          String
  website        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tourPrice      Float
  highlights     String[]
  recommendLevel Int?           @default(0)
  engName        String?
  isForChildren  Boolean        @default(false)
  summary        String?
  blurb          String?
  artworks       Artwork[]
  bookings       Booking[]
  exhibition     Exhibition[]
  museumInfo     MuseumInfo?
  openingHours   OpeningHours[]
  trivia         Trivia[]
  hasVisited     hasVisited[]
}

model Artwork {
  id             String   @id @default(uuid())
  title          String
  artist         String?
  year           String?
  location       String?
  description    String?
  isOnDisplay    Boolean  @default(true)
  museumId       String   @default("6cc90107-59e4-45a8-b901-abb9748ebeea")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  image          String?
  room           String?
  mustSee        Boolean
  recommendLevel Int      @default(0)
  highlights     String[]
  engTitle       String?
  museum         Museum   @relation(fields: [museumId], references: [id])
}

model hasVisited {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profileId String
  museumId  String
  museum    Museum   @relation(fields: [museumId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [clerkId], onDelete: Cascade)
}

model Booking {
  id            String   @id @default(uuid())
  tourDate      DateTime
  numGuests     Int
  paymentStatus Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profileId     String
  museumId      String
  museum        Museum   @relation(fields: [museumId], references: [id], onDelete: Cascade)
  profile       Profile  @relation(fields: [profileId], references: [clerkId], onDelete: Cascade)
}

model OpeningHours {
  id        String  @id @default(uuid())
  museumId  String
  dayOfWeek String
  openTime  String?
  closeTime String?
  museum    Museum  @relation(fields: [museumId], references: [id])

  @@unique([museumId, dayOfWeek])
}

model Exhibition {
  id          String   @id @default(cuid())
  museumId    String
  name        String
  description String
  startDate   DateTime
  endDate     DateTime
  admission   Float
  Museum      Museum   @relation(fields: [museumId], references: [id])
}

model Trivia {
  id       String @id @default(cuid())
  museumId String
  title    String
  content  String
  Museum   Museum @relation(fields: [museumId], references: [id])
}

model MuseumInfo {
  id                    String   @id @default(cuid())
  museumId              String   @unique
  photographyAllowed    String?
  reservationRequired   Boolean?
  cloakroomInfo         String?
  nearestStation        String?
  stationWalkingMinutes Int?
  nearestBusStop        String?
  busStopWalkingMinutes Int?
  guidedTourAvailable   Boolean?
  guidedTourLanguages   String?
  cafeteriaAvailable    Boolean?
  shopAvailable         Boolean?
  wifiAvailable         Boolean?
  website               String?
  admissionFeeAdult     Float?
  admissionFeeStudent   Float?
  admissionFeeChild     Float?
  recommendedDuration   Int?
  guidedTourFee         Float?
  museum                Museum   @relation(fields: [museumId], references: [id])
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String
  tags        String[]
  views_count Int      @default(0)
  image       String   @default("/news-bg.JPG")
  summary     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Musical {
  id             String   @id @default(uuid())
  name           String
  engName        String
  slug           String   @unique
  tagline        String?
  description    String
  summary        String
  blurb          String?
  highlights     String[]
  theatreName    String
  address        String
  lat            Float
  lng            Float
  image          String
  website        String
  isOnShow       Boolean
  recommendLevel Int      @default(0)
  mustSee        Boolean
  original       String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  songs          Song[]
}

model Song {
  id        String   @id @default(cuid())
  name      String
  artist    String
  lyrics    String
  scene     String
  musicalId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  index     Int
  youtubeId String?
  musical   Musical  @relation(fields: [musicalId], references: [id])
}

model Post {
  id           String    @id @default(cuid())
  category     String    @default("none")
  author       String
  deletePsswrd String    @default("0000")
  title        String
  content      String
  votes        Int       @default(0)
  views        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  ip           String?
  sessionId    String?
  userAgent    String?
  comments     Comment[]
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  parentId  String?
  author    String
  content   String
  votes     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ip        String?
  sessionId String?
  userAgent String?
  parent    Comment?  @relation("CommentToChildren", fields: [parentId], references: [id])
  children  Comment[] @relation("CommentToChildren")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Contact {
  id        String  @id @default(cuid())
  email     String
  token     String  @unique
  message   String
  name      String
  confirmed Boolean @default(false)
}

model Attraction {
  id             String              @id @default(uuid())
  name           String              @unique
  engName        String?
  slug           String              @unique
  tagline        String?
  summary        String?
  address        String
  lat            Float
  lng            Float
  image          String
  website        String?
  recommendLevel Int?                @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  category       String              @default("")
  mustSee        Boolean             @default(false)
  isForKids      Boolean             @default(false)
  isFree         Boolean             @default(false)
  sections       AttractionSection[]
}

// イギリス料理1品(/restaurants/[slug])。
//
// 店ではなく料理を軸にしているのは、読者が「フィッシュ&チップスを食べたい」
// から店を探すため。もうひとつ実務的な理由があり、店の写真は権利処理が
// 面倒なのに対して料理の写真は自由に使えるものが揃っているので、
// 料理を単位にすると各ページが確実に1枚は画像を持てる。
model Dish {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  engName  String
  tagline  String
  /// ハブ(/restaurants)のカードに出す説明。
  summary  String
  /// 料理そのものの解説。markdown。
  body     String
  /// 頼み方・食べ方のコツ。markdown。
  howTo    String?
  priceRange String?
  /// 「土曜の昼」「日曜だけ」など、食べに行くべき時間帯。
  bestTime   String?

  image       String?
  imageSource String?
  imageCredit String?
  imageLink   String?

  displayOrder Int          @default(0)
  restaurants  Restaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 料理に紐づく店。
//
// 1つの店が複数の料理を出すことはあるが(パブは日曜ローストも朝食も出す)、
// 特集としては「その店を何で推すのか」が定まっている方が読みやすいので
// 多対多にはしていない。両方で推したくなったら、そのとき初めて中間表を作る。
//
// 住所を持たせていないのは番地の裏取りができないため。エリアと最寄り駅、
// そして公式サイトへのリンクがあれば読者は辿り着ける。
model Restaurant {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  engName String
  dishId  String
  dish    Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)

  /// カード用の一言。なぜこの店なのかを1文で。
  blurb String
  body  String?

  area            String
  nearestStation  String?
  priceRange      String?
  website         String?
  bookingRequired Boolean @default(false)

  /// 店の公式アカウントの「投稿」URL(https://www.instagram.com/p/... )。
  /// プロフィールURLでは埋め込めない。Instagram はプロフィール単位の
  /// 埋め込みを廃止しており、埋め込めるのは個別の投稿と Reels だけ。
  instagramUrl String?

  image       String?
  imageSource String?
  imageCredit String?
  imageLink   String?

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dishId])
}

// ロンドン土産の特集(/souvenirs)で紹介する1品。
//
// image を nullable にしているのは、写真を自前で撮らない運用が前提だから。
// 「画像が揃ってから公開する」にすると1件も出せなくなるので、
// 画像なしでも成立するカードを描く前提で null を許容している。
//
// imageSource は表示側の分岐に使う。ライセンス表記が要るソース(commons)と、
// 提携先のCDNから直接配信しなければならないソース(rakuten / amazon)とで
// 扱いが変わるため、URL だけを持っていても正しく描けない。
model Souvenir {
  id             String   @id @default(cuid())
  name           String
  engName        String?
  slug           String   @unique
  category       String
  /// カード用の一言。詳細を開かなくても選べる粒度で書く。
  blurb          String
  /// 詳細の本文。markdown。
  body           String
  priceRange     String?
  /// 買える場所。「ヒースロー空港」「Tesco」など。
  buyAt          String[] @default([])
  tips           String?
  recommendLevel Int      @default(0)
  displayOrder   Int      @default(0)

  image        String?
  /// "commons" | "rakuten" | "amazon" | "official" | "own"
  imageSource  String?
  /// 出典・ライセンス表記。commons のときは必須。
  imageCredit  String?
  imageLink    String?
  affiliateUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// イギリス発のブランド1社(/brands/[slug])。
//
// Souvenir と軸が違う。あちらは品目単位で「誰に何を配るか」を扱うのに対し、
// こちらはブランド単位で「その会社が何者で、ロンドンのどこで、いくらで買えるか」
// を扱う。Twinings のように両方に登場する名前はあるが、書く内容が重ならないので
// 統合しない。
//
// 本文を story と buying の2本に割っているのは、読者の来方が二通りあるため。
// 「バーバリー 歴史」で来た人と「バーバリー ロンドン 安い」で来た人が同じ順に
// 読むことはないので、1本の body に混ぜると必ずどちらかが読み飛ばしになる。
model Brand {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  engName String
  /// "fashion" | "footwear" | "outdoor" | "beauty" | "homeware" | "food"
  category String
  /// カード用の一言。詳細を開かなくても選べる粒度で書く。
  blurb String
  /// 特徴・魅力。markdown。ページの最初に読ませる。
  /// 歴史より前に置くのは、読者がまず知りたいのが「何が良いのか」であって
  /// 「いつ誰が創業したか」ではないため。年号から入ると大半が離脱する。
  appeal String
  /// 歴史。markdown。創業の経緯、定番品が生まれた背景。
  story String
  /// 買い方の実務。markdown。日本との価格差、いつ買うか。
  buying String

  founded Int?
  /// 発祥地。「ロンドン・ストランド」「ノーサンバーランド州」など。
  origin  String?
  /// 王室御用達(Royal Warrant)を現在保持しているか。
  /// authorised が取り消される例があるので、過去の保持は true にしない。
  royalWarrant Boolean @default(false)

  priceRange String?
  website    String?
  tips       String?

  /// 公式アカウントの「投稿」URL(https://www.instagram.com/p/... )。
  /// プロフィールURLでは埋め込めない(Restaurant.instagramUrl と同じ制約)。
  ///
  /// ヒーロー画像と併存させるのは、Commons にあるのが店舗外観や史料の写真
  /// ばかりで、そのブランドが「今」何を作っているのかが写らないため。
  /// 商品そのものは公式の投稿を埋め込むのが、複製を伴わない分いちばん安全。
  instagramUrl String?

  recommendLevel Int @default(0)
  displayOrder   Int @default(0)

  image       String?
  /// "commons" | "rakuten" | "amazon" | "official" | "own"
  imageSource String?
  /// 出典・ライセンス表記。commons のときは必須。
  imageCredit String?
  imageLink   String?

  items  BrandItem[]
  images BrandImage[]
  stores BrandStore[]
  faqs   BrandFaq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// ブランドを買える場所。旗艦店・直営店・アウトレット・取扱店。
///
/// 以前は Brand.buyAt(文字列配列)と Brand.flagship(1行テキスト)に分かれていたが、
/// 同じ店が両方に出て内容がずれるため一本化した。
///
/// 営業時間は持たない。変わりやすく、古い時間を載せたままにすると
/// 「行ったら閉まっていた」を引き起こす(Restaurant と同じ判断)。
/// 開いているかは公式サイトで確認してもらう。
model BrandStore {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// "flagship"(旗艦店) | "store"(直営店) | "outlet"(アウトレット) | "retailer"(取扱店・百貨店/スーパー)
  kind String
  name String
  /// 番地まで。retailer で特定の店舗を指さない場合は null。
  address        String?
  nearestStation String?
  /// その店ならではの事情。「ここだけ限定ブレンドがある」「間口が狭く見落としやすい」など。
  note String?

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, displayOrder])
}

/// ブランドごとのFAQ。
///
/// ハブ(/brands)のFAQが買い物全般の前提を扱うのに対し、こちらは
/// そのブランドでだけ生じる疑問を扱う。サイズの選び方、持ち帰りの可否、
/// 日本との違いなど、ブランドによって答えが変わるものだけを置く。
///
/// 本文の再掲になっても構わない。FAQ の構造化データは質問文で検索された
/// ときに拾われるので、同じ情報でも到達経路が増える。
model BrandFaq {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  question String
  /// markdown可。JSON-LD に出す際は stripInlineMarkdown() を通すこと。
  answer   String

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, displayOrder])
}

/// 記事の途中に挟む画像。Brand.image(冒頭のヒーロー)とは別物。
///
/// 本文の markdown に ![](...) を直接書かないのは、Commons の画像が
/// 作者名とライセンスの表記を要求するため。URL だけを本文に埋めると
/// 表記が本文と分離して、差し替えたときに古い表記が残る。
/// 画像と出典を1レコードにまとめ、表示側で必ず並べて描く。
model BrandImage {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// 本文のどのセクションの後に置くか。"story" | "buying"
  section String
  url     String
  /// 画像の下に出す説明。何が写っているかだけでなく、本文のどこに効くかを書く。
  caption String

  imageSource String?
  imageCredit String?
  imageLink   String?

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, section, displayOrder])
}

/// ブランドの定番アイテム。「そのブランドで何を買えばいいか」に答えるためのもので、
/// 在庫や現在価格は追わない。priceRange は幅で持ち、変動しても嘘にならない粒度にする。
model BrandItem {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name       String
  engName    String?
  /// なぜこれが定番なのかの一言。
  note       String
  priceRange String?

  /// 定番品そのものの写真。
  ///
  /// ブランドの魅力は結局「何が買えるか」なので、外観写真より効く。
  /// ただし商品写真は Commons にほぼ無く、出典は公式か Commons に限る。
  /// 通販サイトの商品画像を直リンクすると、URLが切れたときに黙って
  /// 画像が消えるうえ、そもそも再配布の許諾がない。
  image       String?
  /// "commons" | "official"
  imageSource String?
  /// 出典・ライセンス表記。commons のときは必須。
  imageCredit String?
  imageLink   String?

  affiliateUrl String?
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, displayOrder])
}

model AttractionSection {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  displayOrder Int
  attractionId String
  createdAt    DateTime   @default(now())
  attraction   Attraction @relation(fields: [attractionId], references: [id])
}


  model Content {
  id String  @id @default(cuid())
  title     String
  engTitle     String?
  slug      String    
  summary   String?
  mainText  String?
  description   String?
  description2  String?  
  description3  String?  
  image        String?
  website      String?
  category     String    @default("")
  route     String   @default("")
  sections  ContentSection[]
  createdAt DateTime         @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}


model ContentSection {
  id            Int       @id @default(autoincrement())
  title         String
  subtitle      String?
  description   String?
  description2  String?  
  description3  String?  
  displayOrder  Int @default(0)
  image         String?
  contentId  String
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  }

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String
  startDate       DateTime
  endDate         DateTime
  image           String?
  website         String?
  displayOrder    Int      @default(0)
  // 「特徴・おすすめポイント」など、開催概要だけでは分からない実用情報
  category        String?
  venue           String?
  area            String?
  nearestStation  String?
  priceInfo       String?
  isFree          Boolean  @default(false)
  bookingRequired Boolean  @default(false)
  highlights      String[] @default([])
  tips            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startDate])
}

/// 「今週のロンドン」週次ダイジェストの1号分。
/// Event テーブル(1年前から分かっている定番イベント)とは役割が違う。
/// こちらは「4週間前には書けなかったこと」= ストライキ・突発イベント・耳寄り情報だけを扱う。
model WeeklyBrief {
  id        String   @id @default(cuid())
  /// "2026-w33"。ISO週番号ベースで、週の月曜から一意に決まる。
  slug      String   @unique
  /// 週の月曜 00:00 UTC。weekEnd はその週の日曜 00:00 UTC。
  weekStart DateTime
  weekEnd   DateTime
  title     String
  /// 「今週はここに注意」の1〜2文。ページ冒頭に大きく出す。
  headline  String
  summary   String
  image     String?
  /// 調査した日時。ページに「◯月◯日 調査時点」として必ず表示する。
  /// ストライキ情報は数日で覆るので、いつ時点の情報かを出さないと誤情報になる。
  researchedAt DateTime
  /// 下書き段階で公開されないようにするためのフラグ。
  published Boolean  @default(false)
  items     WeeklyBriefItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekStart])
  @@index([published, weekStart])
}

model WeeklyBriefItem {
  id      String @id @default(cuid())
  briefId String
  brief   WeeklyBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  /// 支障系: strike | disruption | closure | crowd
  /// 機会系: event | exhibition | deal | opening
  /// 環境系: weather | holiday
  kind     String
  /// 支障系のみ。high(旅程の変更が要る) | medium(迂回で回避可) | low(知ると快適)
  severity String?
  /// なぜ今週号に載るか。thisWeek(今週起きる) | announced(今週判明した/発生は先)
  timing   String @default("thisWeek")
  /// confirmed | planned。ストライキ予告は直前の妥結で中止になるため planned は本文で明示する。
  status   String @default("confirmed")

  title       String
  description String

  startDate      DateTime?
  endDate        DateTime?
  venue          String?
  area           String?
  nearestStation String?
  priceInfo      String?
  isFree         Boolean @default(false)
  website        String?

  /// 出典URL。一次ソース(TfL・会場公式・労組公式)優先。必須。
  source     String
  /// 二次ソース(Time Out London 等)の場合に媒体名を出して読者に判別させる。
  sourceName String?

  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([briefId, displayOrder])
}

model Lyrics {
  id           String        @id @default(cuid())
  name         String
  artistId     String
  lyrics       String
  album        String?
  youtubeId    String?
  views        Int           @default(0)
  lastViewedAt DateTime?
  genre        String?
  createdAt    DateTime      @default(now())
  scene        String?
  year         Int           @default(0)
  month        Int           @default(0)
  albumOrder   Int           @default(0)
  artist       Artist        @relation(fields: [artistId], references: [id])
  rankings     Ranking[]
  slangs       LyricsSlang[]

  @@index([artistId, album])
}

model Slang {
  id          String        @id @default(cuid())
  term        String        @unique
  slug        String        @unique
  meaning     String
  explanation String?
  category    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lyrics      LyricsSlang[]
}

model LyricsSlang {
  id           String   @id @default(cuid())
  lyricsId     String
  slangId      String
  lineExcerpt  String?
  contextNote  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  lyrics       Lyrics   @relation(fields: [lyricsId], references: [id], onDelete: Cascade)
  slang        Slang    @relation(fields: [slangId], references: [id], onDelete: Cascade)

  @@unique([lyricsId, slangId])
  @@index([slangId])
}

model Artist {
  id        String    @id @default(cuid())
  name      String
  engName   String
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isHot     Boolean?
  songs     Lyrics[]
  rankings  Ranking[]
}

model Ranking {
  id          String      @id @default(cuid())
  type        RankingType
  rank        Int
  periodStart DateTime
  periodEnd   DateTime
  lyricsId    String?
  artistId    String?
  album       String?
  artist      Artist?     @relation(fields: [artistId], references: [id])
  lyrics      Lyrics?     @relation(fields: [lyricsId], references: [id])

  @@index([type, periodEnd])
}

model LyricsRequest {
  id        Int      @id @default(autoincrement())
  title     String
  artist    String?
  createdAt DateTime @default(now())
}

model Store {
  id         String   @id @default(cuid())
  name       String
  address    String
  lat        Float?
  lng        Float?
  borough    String?
  postcode   String?
  aliases    String[] @default([])
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([name])
}

model ServiceCharge {
  id                     String   @id
  placeId                String
  storeName              String
  storeAddress           String
  lat                    Float?
  lng                    Float?
  borough                String?
  postcode               String?
  isVerified             Boolean  @default(true)
  serviceChargeCollected Boolean
  distributionType       String?
  amountPeriod           String?
  amountValue            Float?
  createdAt              DateTime @default(now())
  ethnicityRatio         String?
  generalComment         String?
  managementPresence     String?
  mealCountPerDay        String?
  mealDrink              String?
  mealRestrictions       String[]
  serviceChargeComment   String?
  shiftSchedule          String?
  visaSupport            String?
  workAtmosphere         String?
  mealComment            String?

  @@index([placeId])
  @@index([serviceChargeCollected])
}

model RedditPost {
  id           String   @id @default(cuid())
  title        String
  titleJa      String
  authorId     String?
  createdAt    DateTime @default(now())
  redditId     String
  displayOrder Int
  reddit       Reddit   @relation(fields: [redditId], references: [id])

  @@index([redditId])
}

model Reddit {
  id        String       @id @default(cuid())
  imageUrl  String?
  title     String       @unique
  titleJa   String
  authorId  String?
  postedAt  DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  body      String
  bodyJa    String
  posts     RedditPost[]
}

enum RankingType {
  HOT_SONGS
  HOT_ARTISTS
  HOT_ALBUM
}
